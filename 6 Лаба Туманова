# ---------------------------------------------------------
# 1. Когортный анализ по накопительному итогу заказов
# ---------------------------------------------------------

query_cumulative = '''
WITH user_cohorts AS (
    SELECT 
        id AS user_id,
        STRFTIME('%Y-%m', registration_date) AS cohort_month
    FROM Users
),
user_orders AS (
    SELECT 
        uc.cohort_month,
        o.id AS order_id,
        (STRFTIME('%Y', o.order_date) - STRFTIME('%Y', uc.cohort_month || '-01')) * 12 +
        (STRFTIME('%m', o.order_date) - STRFTIME('%m', uc.cohort_month || '-01')) AS month_from_reg
    FROM user_cohorts uc
    JOIN Orders o ON uc.user_id = o.user_id
    WHERE o.order_date IS NOT NULL
)
SELECT 
    cohort_month,
    month_from_reg,
    COUNT(order_id) AS orders_in_month,
    SUM(COUNT(order_id)) OVER (
        PARTITION BY cohort_month
        ORDER BY month_from_reg
    ) AS cumulative_orders
FROM user_orders
GROUP BY cohort_month, month_from_reg
ORDER BY cohort_month, month_from_reg
'''

df_cumulative = pd.read_sql_query(query_cumulative, conn)

print("\n1) Накопительный итог заказов по когортам:")
print(df_cumulative)

plt.figure(figsize=(12, 6))

for cohort in sorted(df_cumulative['cohort_month'].unique()):
    cohort_data = df_cumulative[df_cumulative['cohort_month'] == cohort]
    plt.plot(
        cohort_data['month_from_reg'],
        cohort_data['cumulative_orders'],
        marker='o',
        label=cohort
    )

plt.xlabel('Месяц после регистрации')
plt.ylabel('Накопительное количество заказов')
plt.title('Накопительный итог заказов по когортам')
plt.legend(title='Когорта')
plt.grid(True)
plt.tight_layout()
plt.show()

