# ---------------------------------------------------------
# 5. Анализ возвращаемости пользователей по профессиям
# ---------------------------------------------------------

query_returning = '''
WITH user_orders_stats AS (
    SELECT 
        u.profession,
        u.id AS user_id,
        COUNT(o.id) AS total_orders,
        CASE 
            WHEN COUNT(o.id) >= 2 THEN 1
            ELSE 0
        END AS is_returning
    FROM Users u
    LEFT JOIN Orders o ON u.id = o.user_id
    GROUP BY u.profession, u.id
)
SELECT
    profession,
    COUNT(user_id) AS total_users,
    COUNT(CASE WHEN total_orders > 0 THEN user_id END) AS users_with_orders,
    SUM(total_orders) AS total_orders,
    SUM(is_returning) AS returning_users,
    ROUND(AVG(total_orders), 2) AS avg_orders_per_user,
    ROUND(
        100.0 * SUM(is_returning) /
        NULLIF(COUNT(CASE WHEN total_orders > 0 THEN user_id END), 0),
        1
    ) AS returning_rate
FROM user_orders_stats
GROUP BY profession
HAVING users_with_orders > 0
ORDER BY returning_rate DESC
'''

df_returning = pd.read_sql_query(query_returning, conn)

print("\n5) Возвращаемость пользователей по профессиям:")
print(df_returning)

plt.figure(figsize=(14, 6))
plt.bar(df_returning['profession'], df_returning['returning_rate'])
plt.xlabel('Профессия')
plt.ylabel('Возвращаемость (%)')
plt.title('Процент пользователей, совершивших повторный заказ')
plt.xticks(rotation=45, ha='right')
plt.grid(True, axis='y')
plt.tight_layout()
plt.show()

